[MASTER]
ignore=CVS,.git,__pycache__,venv,.venv,node_modules
jobs=1
persistent=yes
unsafe-load-any-extension=no

[MESSAGES]
disable=missing-docstring,line-too-long,too-many-arguments,too-many-locals,too-few-public-methods,too-many-branches,too-many-statements,too-many-instance-attributes,too-many-public-methods,import-error,invalid-name,missing-module-docstring,no-member

[REPORTS]
output-format=text
reports=no
score=yes

[REFACTORING]
max-nested-blocks=5
never-returning-functions=sys.exit,argparse.parse_error

[BASIC]
argument-naming-style=snake_case
attr-naming-style=snake_case
class-attribute-naming-style=any
class-const-naming-style=UPPER_CASE
class-naming-style=PascalCase
const-naming-style=UPPER_CASE
function-naming-style=snake_case
inlinevar-naming-style=any
method-naming-style=snake_case
module-naming-style=snake_case
variable-naming-style=snake_case
good-names=i,j,k,ex,Run,_,db

[FORMAT]
indent-string='    '
indent-after-paren=4
max-line-length=120
max-module-lines=1000
single-line-class-stmt=no
single-line-if-stmt=no

[DESIGN]
max-args=8
max-attributes=12
max-bool-expr=5
max-branches=15
max-locals=20
max-parents=7
max-public-methods=25
max-returns=6
max-statements=60
min-public-methods=1

[IMPORTS]
known-third-party=fastapi,sqlalchemy,pydantic,uvicorn,pymysql

[EXCEPTIONS]
overgeneral-exceptions=builtins.Exception